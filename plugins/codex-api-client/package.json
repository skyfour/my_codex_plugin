{
  "name": "codex-api-client",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --experimental-sqlite src/server.mjs",
    "dev": "node --experimental-sqlite scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "test:ui": "npm run build && playwright test --config playwright.tree.config.ts",
    "check": "node --experimental-sqlite scripts/check.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/theme-one-dark": "^6.0.0",
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "codemirror": "^6.0.0",
    "csv-parse": "^6.0.0",
    "grpc-js-reflection-client": "1.4.1",
    "mqtt": "^5.16.1",
    "openapi-to-postmanv2": "6.4.2",
    "postman-collection": "^5.0.0",
    "postman-request": "^2.88.1-postman.0",
    "postman-runtime": "^7.0.0",
    "protobufjs": "7.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shell-quote": "^1.8.0",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.0",
    "yaml": "2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@grpc/reflection": "^1.0.4",
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "aedes": "^1.2.0",
    "socket.io": "^4.8.4",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
